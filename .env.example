# === Backend Configuration ===

# API Gateway
PORT=4000
NODE_ENV=development

# Authentication Service
AUTH_PORT=4001
MONGO_URI=mongodb://admin:password@localhost:27017/food_app_auth?authSource=admin
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Inventory Service
INVENTORY_PORT=4002
INVENTORY_MONGO_URI=mongodb://admin:password@localhost:27017/food_app_inventory?authSource=admin

# Order Service
ORDER_PORT=4003
ORDER_MONGO_URI=mongodb://admin:password@localhost:27017/food_app_orders?authSource=admin

# Payment Service
PAYMENT_PORT=4005
PAYMENT_MONGO_URI=mongodb://admin:password@localhost:27017/food_app_payments?authSource=admin
STRIPE_SECRET_KEY=your-stripe-secret-test-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-test-key
KHALTI_PUBLIC_KEY=your-khalti-public-key
KHALTI_SECRET_KEY=your-khalti-secret-key
ESEWA_MERCHANT_CODE=your-esewa-merchant-code

# Notification Service
NOTIFICATION_PORT=4006
NOTIFICATION_MONGO_URI=mongodb://admin:password@localhost:27017/food_app_notifications?authSource=admin
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@foodapp.com

# Logistics Service
LOGISTICS_PORT=4004

# Service URLs (for API Gateway routing)
AUTH_URL=http://localhost:4001
INVENTORY_URL=http://localhost:4002
ORDERS_URL=http://localhost:4003
PAYMENT_URL=http://localhost:4005
NOTIFICATION_URL=http://localhost:4006
LOGISTICS_URL=http://localhost:4004

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:password@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=password

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=food_app_db

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379

# === Frontend Configuration ===
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4004
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# === Feature Flags ===
ENABLE_PAYMENT_PROCESSING=true
ENABLE_STRIPE=true
ENABLE_KHALTI=false
ENABLE_ESEWA=false
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
